// Prisma schema — Better Auth core models + mcell consent audit table.
// Prisma 7: prisma-client generator (client generated to src/generated/prisma),
// datasource url lives in prisma.config.ts (v7 removed datasource url from schema).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String? // future account-page avatar
  role          Role     @default(NORMAL)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  consents      UserConsent[]
  boardPosts    BoardPost[]
  inquiries     Inquiry[]

  @@map("user")
}

/// NORMAL: 프로필 페이지만. ADMIN: + 대시보드(CRM/콘텐츠).
enum Role {
  NORMAL
  ADMIN

  @@map("role")
}

/// 슈퍼유저(승격/강등 모두 가능)는 DB에서 role=SUPER로 표시하지 않고
/// SUPERUSER_EMAIL env와 일치하는 이메일로 판별한다 (env 기준 = 단일 진실 소스).
/// DB role은 NORMAL/ADMIN만 저장한다.

model BoardPost {
  id        String   @id @default(cuid())
  board     String // "notices" | "updates" | "catalog" | "portfolio"
  category  String
  title     String
  body      String? // HTML
  author    String
  authorId  String?
  authorUser User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  views     Int      @default(0)
  published Boolean  @default(true) // false = 임시저장/숨김
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  attachment BoardAttachment?

  @@index([board, published, createdAt])
  @@map("board_post")
}

model BoardAttachment {
  id       String @id @default(cuid())
  postId   String @unique
  post     BoardPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  name     String
  size     String // 표시용 (KB)
  href     String // /assets/pdf/... 또는 blob url
  @@map("board_attachment")
}

/// 페이지 콘텐츠 오버라이드 (관리자 수정 가능 문구; 없으면 TS 데이터 파일 기본값 사용)
model PageContent {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @default(now()) @updatedAt
  @@map("page_content")
}

/// 제휴/문의 (파트너십 폼) + 홈/기술 문의 등 모든 폼 접수
model Inquiry {
  id        String   @id @default(cuid())
  type      String   @default("partnership") // "partnership" | "home" | "mcell" ...
  company   String?
  manager   String? // 담당자(회사명)
  phone     String?
  email     String?
  address   String?
  oemType   String? // "OEM" | "ODM"
  content   String? // 개발내용
  status    String   @default("new") // "new" | "in_progress" | "done"
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("inquiry")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  scope                 String?
  password              String? // credentials hash (Better Auth scrypt)

  @@unique([issuer, accountId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

/// 사이트 설정 — 회사/연락처/소셜 등 관리자 편집 가능 키.
/// value 가 비어 있으면 src/data/site.ts 의 기본값이 사용된다.
model SiteSetting {
  key       String   @id // "company.name" | "company.address" | ... | "social.facebook"
  group     String   // "company" | "social"
  label     String
  value     String   @default("")
  kind      String   @default("string") // "string" | "textarea" | "url" | "email" | "tel"
  updatedBy String?
  updatedAt DateTime @default(now()) @updatedAt

  @@map("site_setting")
}

/// 동의 감사 기록 (이용약관/개인정보/14세 — 가입 시점 스냅샷)
model UserConsent {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type     String   // "policy" | "privacy" | "age14"
  version  String   // AGREEMENT_VERSION from src/data/auth.ts
  agreedAt DateTime @default(now())
  ip       String?

  @@index([userId])
  @@map("user_consent")
}